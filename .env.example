# Core App
APP_URL="https://pinnacleconsultant.co.in"
PORT=3000

# ──────────────────────────────────────────────────────────────────────────────
# Google — Apps Script Web App (Only this one URL is needed!)
# 1. Open your Google Sheet → Extensions → Apps Script
# 2. Paste the code from scripts/AppsScript.gs (update SHEET_ID & DRIVE_FOLDER_ID inside)
# 3. Deploy → New deployment → Web App (Execute as: Me, Who: Anyone)
# 4. Paste the Web App URL below
# ──────────────────────────────────────────────────────────────────────────────
GOOGLE_APPS_SCRIPT_URL=""
GOOGLE_APPS_SCRIPT_SECRET=""  # Set same secret in AppsScript.gs to lock down applications

# Sheet link shown in WhatsApp notifications (optional, for quick access)
APPLICATIONS_SHEET_URL="https://docs.google.com/spreadsheets/d/your_sheet_id_here/edit"

# ──────────────────────────────────────────────────────────────────────────────
# WhatsApp Notifications
# ──────────────────────────────────────────────────────────────────────────────
# Provider options: 'callmebot' | 'meta' | 'ultramsg' | 'twilio' | 'webhook'
WHATSAPP_PROVIDER="callmebot"
OWNER_WHATSAPP_NUMBER="917000081129"

# CallMeBot (Free, instant setup — WhatsApp "+34 644 44 20 54" the text: "I allow callmebot to send me messages")
CALLMEBOT_API_KEY=""

# Alternative providers (leave blank unless using them)
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE_NAME="new_job_application"
# ULTRAMSG_INSTANCE_ID=""
# ULTRAMSG_TOKEN=""
# NOTIFICATION_WEBHOOK_URL=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_NUMBER=""

# ──────────────────────────────────────────────────────────────────────────────
# Anti-Spam & Rate Limiting (Cloudflare Turnstile — optional in dev)
# ──────────────────────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""
RATE_LIMIT_PER_HOUR=5

# ──────────────────────────────────────────────────────────────────────────────
# Upstash Redis (optional — rate limiting & retry queue; falls back to in-memory)
# ──────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI / Legacy
GEMINI_API_KEY=""
